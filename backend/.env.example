# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
# Remember to URL-encode special characters in your password.
MONGO_URI=mongodb+srv://<gyanendrackt058_db_user>:<Gyanu2003>@<cluster>.mongodb.net/employee_management?retryWrites=true&w=majority

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Frontend URL(s) allowed to call this API (comma-separated)
CLIENT_URL=http://localhost:5173

# Used only by "npm run seed:admin" to create the FIRST admin
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=ChangeMe123
